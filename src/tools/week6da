## 4. Production FastAPI Server

### 4.1 Core Code Structure

```python
"""
Kuber Underwriting API — FastAPI server wrapping LangGraph orchestrator.

Spring Boot equivalents:
  FastAPI()           → @SpringBootApplication
  @app.post()         → @PostMapping
  Pydantic BaseModel  → Java Record / DTO
  BackgroundTasks     → @Async + CompletableFuture
  Depends()           → @Autowired / Constructor Injection
  HTTPException       → ResponseStatusException
"""

import uuid, asyncio
from datetime import datetime
from enum import Enum
from fastapi import FastAPI, HTTPException, BackgroundTasks
from pydantic import BaseModel, Field

# ── Schemas (API Contract) ──────────────────────

class EvaluationStatus(str, Enum):
    PENDING = "PENDING"
    RUNNING = "RUNNING"
    COMPLETE = "COMPLETE"
    FAILED = "FAILED"

class EvaluationRequest(BaseModel):
    application_id: str = Field(..., example="APP-001")
    loan_type: str = Field(..., example="conventional")
    jurisdiction: str = Field(..., example="TX")
    borrower_data: dict
    documents: list[str] = Field(default=[])
    priority: str = Field(default="normal", pattern="^(high|normal|low)$")

class EvaluationSubmitResponse(BaseModel):
    job_id: str
    status: EvaluationStatus
    submitted_at: str
    estimated_duration_seconds: int = 15

# ── App Lifecycle ───────────────────────────────

@asynccontextmanager
async def lifespan(app: FastAPI):
    """Like @PostConstruct / @PreDestroy in Spring."""
    app.state.redis = redis.from_url("redis://kuber-redis:6379")
    app.state.graph = build_underwriting_graph()
    app.state.jobs = {}
    yield
    await app.state.redis.close()

app = FastAPI(title="Kuber Underwriting API", lifespan=lifespan)

# ── Background Execution ───────────────────────

async def run_evaluation(job_id, request, app_state):
    job = app_state.jobs[job_id]
    job["status"] = EvaluationStatus.RUNNING
    try:
        result = await asyncio.to_thread(
            app_state.graph.invoke,
            {"application_id": request.application_id, ...},
            config={"configurable": {"thread_id": job_id}}
        )
        job["status"] = EvaluationStatus.COMPLETE
        job["result"] = result
    except Exception as e:
        job["status"] = EvaluationStatus.FAILED
        job["error"] = str(e)

# ── Endpoints ──────────────────────────────────

@app.post("/evaluate", response_model=EvaluationSubmitResponse, status_code=202)
async def submit_evaluation(request: EvaluationRequest, bg: BackgroundTasks):
    """Submit evaluation. Returns immediately with job_id. HTTP 202."""
    job_id = str(uuid.uuid4())
    app.state.jobs[job_id] = {"status": EvaluationStatus.PENDING, ...}
    bg.add_task(run_evaluation, job_id, request, app.state)
    return EvaluationSubmitResponse(job_id=job_id, ...)

@app.get("/evaluate/{job_id}/status")
async def get_status(job_id: str):
    if job_id not in app.state.jobs:
        raise HTTPException(status_code=404, detail="Job not found")
    return app.state.jobs[job_id]

@app.get("/evaluate/{job_id}/result")
async def get_result(job_id: str):
    job = app.state.jobs.get(job_id)
    if not job: raise HTTPException(404, "Not found")
    if job["status"] != EvaluationStatus.COMPLETE:
        raise HTTPException(409, f"Not complete: {job['status']}")
    return job["result"]

@app.get("/health")
async def health():
    """ALB health check. Like /actuator/health in Spring Boot."""
    redis_ok = await app.state.redis.ping()
    return {"status": "healthy" if redis_ok else "degraded"}
```

### 4.2 SSE Streaming for Real-Time Progress

```python
from fastapi.responses import StreamingResponse

@app.get("/evaluate/{job_id}/stream")
async def stream_evaluation(job_id: str):
    """Stream agent progress via Server-Sent Events."""
    async def event_generator():
        while True:
            job = app.state.jobs.get(job_id)
            if not job: break
            yield f"data: {json.dumps({'status': job['status']})}\n\n"
            if job["status"] in ("COMPLETE", "FAILED"): break
            await asyncio.sleep(1)
    return StreamingResponse(event_generator(), media_type="text/event-stream")
```

