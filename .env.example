# AWS Configuration
AWS_REGION=us-east-1
AWS_PROFILE=default

# Bedrock
BEDROCK_MODEL_ID=amazon.nova-micro-v1:0

# Application
LOG_LEVEL=INFO
ENVIRONMENT=development

# LangSmith Tracing (non-secret values only)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=underwriting-dev

# Keep API key in your terminal/session manager (do NOT commit):
# export LANGCHAIN_API_KEY=your_langsmith_api_key
